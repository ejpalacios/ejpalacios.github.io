  booktitle     = {2016 IEEE 16th International Conference on Environment and Electrical Engineering (EEEIC)},
  title         = {{Smart community load matching using stochastic demand modeling and historical production data}},
  doi           = {10.1109/EEEIC.2016.7555885},
