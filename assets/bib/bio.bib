@article{Wu2020a,
  author        = {Wu, Ying and Wu, Yanpeng and Guerrero, Josep M. and Vasquez, Juan C. and Palacios-Garcia, Emilio J. and Li, Jiao},
  title         = {{Convergence and Interoperability for the Energy Internet: From Ubiquitous Connection to Distributed Automation}},
